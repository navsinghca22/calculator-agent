{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AssumeCdkBootstrapRoles",
            "Effect": "Allow",
            "Action": "sts:AssumeRole",
            "Resource": [
                "arn:aws:iam::663877906853:role/cdk-hnb659fds-deploy-role-663877906853-us-west-2",
                "arn:aws:iam::663877906853:role/cdk-hnb659fds-file-publishing-role-663877906853-us-west-2",
                "arn:aws:iam::663877906853:role/cdk-hnb659fds-image-publishing-role-663877906853-us-west-2",
                "arn:aws:iam::663877906853:role/cdk-hnb659fds-lookup-role-663877906853-us-west-2"
            ]
        },
        {
            "Sid": "ReadCdkBootstrapVersion",
            "Effect": "Allow",
            "Action": "ssm:GetParameter",
            "Resource": "arn:aws:ssm:us-west-2:663877906853:parameter/cdk-bootstrap/hnb659fds/version"
        }
    ]
}
